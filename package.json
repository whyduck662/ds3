{
  "name": "ds03",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/services/*",
    "src/common",
    "src/web-ui"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace identity-service",
    "build": "tsc && npm run build --workspace web-ui",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json && npm run typecheck --workspace web-ui",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:ui": "tsx scripts/test-ui.ts",
    "test:ui:business": "tsx scripts/test-ui-business.ts",
    "verify:tv1": "node scripts/verify-tv1.mjs",
    "check:summary": "node scripts/check-summary.mjs",
    "report:figures": "node scripts/report-figures.mjs",
    "demo": "tsx scripts/demo/run.ts",
    "start": "npm run start --workspace identity-service",
    "up": "node scripts/start.mjs",
    "seed": "tsx scripts/demo/seed.ts",
    "smoke": "tsx tests/e2e/smoke.ts",
    "e2e": "tsx tests/e2e/scenarios.ts",
    "test:concurrency": "tsx tests/concurrency/c01.ts && tsx tests/concurrency/c02.ts",
    "benchmark": "tsx scripts/load/p01.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/amqplib": "^0.10.7",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

{
  "name": "ds03",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/services/*",
    "src/common",
    "src/web-ui"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace identity-service",
    "build": "tsc && npm run build --workspace web-ui",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json && npm run typecheck --workspace web-ui",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "demo": "tsx scripts/demo/run.ts",
    "start": "npm run start --workspace identity-service",
    "up": "node scripts/start.mjs",
    "seed": "tsx scripts/demo/seed.ts",
    "smoke": "tsx tests/e2e/smoke.ts",
    "e2e": "tsx tests/e2e/scenarios.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/amqplib": "^0.10.7"
  }
}
